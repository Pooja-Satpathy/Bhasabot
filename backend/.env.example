# BhashaBot Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ── Groq API ──────────────────────────────────────────────────────────────────────────────
# Get your FREE API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── HuggingFace API (AI4Bharat IndicTrans2) ────────────────────────────────────────────────────────
# Get your FREE API key from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here

# ── Application Settings ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256


# ── ChromaDB Settings ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── HuggingFace Model Cache ───────────────────────────────────────────────────
# Controls where the multilingual-e5-large model (~560MB) is downloaded.
# Set this to a D drive path to avoid filling up your C drive.
# The folder will be created automatically on first run.
HF_HOME=D:\bhashabot\backend\hf_cache
