# BhashaBot Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ── Google Gemini API ──────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Application Settings ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── ChromaDB Settings ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── HuggingFace Model Cache ───────────────────────────────────────────────────
# Controls where the multilingual-e5-large model (~560MB) is downloaded.
# Set this to a D drive path to avoid filling up your C drive.
# The folder will be created automatically on first run.
HF_HOME=D:\bhashabot\backend\hf_cache
