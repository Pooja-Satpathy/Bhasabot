# BhashaBot Docker Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Groq API Key (Required) - Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# HuggingFace Token (Optional - for IndicTrans2 translation fallback)
HF_API_TOKEN=your_huggingface_token_here

# JWT Authentication Secret (Required: 32+ characters)
JWT_SECRET=replace_with_a_secure_random_32_character_string_here
JWT_ALGORITHM=HS256
